# Copy to .env and fill in the values. Never commit .env.

# --- Application ---------------------------------------------------------------
APP_NAME=BiletFlow API
# development | test | production (production refuses weak secrets and non-SMTP email)
APP_ENV=development
APP_DEBUG=true
APP_API_V1_PREFIX=/api/v1
APP_DATABASE_URL=postgresql+psycopg://biletflow:biletflow@localhost:5432/biletflow
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_ACCESS_TOKEN_MINUTES=30
# Public web app URL; used for CORS and for links in emails and Campaign QR codes.
APP_FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, as a JSON list.
APP_CORS_ORIGINS=[]
APP_ACTIVATION_FEE_MINOR=100000
APP_PROCESSING_FEE_BPS=300
APP_TICKET_HOLD_MINUTES=15
APP_EMAIL_VERIFICATION_HOURS=24
APP_PASSWORD_RESET_MINUTES=30

# --- Email ---------------------------------------------------------------------
# console: print emails to the API log (default, no SMTP needed)
# smtp:    deliver through the SMTP server below (required when APP_ENV=production)
# While EMAIL_BACKEND is not smtp, verification/reset tokens are also returned in
# X-Demo-Verification-Token / X-Demo-Reset-Token response headers for local testing.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=no-reply@biletflow.kz
EMAIL_FROM_NAME=BiletFlow
EMAIL_REPLY_TO=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none (local relay such as Mailpit on port 1025)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20
